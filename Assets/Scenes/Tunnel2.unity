  mainScript: {fileID: 1336605709}
  leftHandNFI: {fileID: 361788072}
  rightHandNFI: {fileID: 361788070}
  ellaAnimator: {fileID: 160470703}
  ellaLines:
  - Do you need help?
  - You are in a wagon with a lever in front of you.
  - On your right, there is a display with questions.
  - If you get it right, you will go through.
  - Get all questions right, in order to win.
  - When you are ready to start, press Continue.
  ellaDialogUI: {fileID: 1838454043}
  ellaDialogText: {fileID: 1863610870}
  ellaYesButton: {fileID: 662156286}
  ellaNoButton: {fileID: 1422962278}
  ellaContinueButton: {fileID: 1914306765}
  dannyAnimator: {fileID: 470238672}
  dannyLines:
  - This is the Tunnel Challenge.
  - Use that lever to steer the wagon.
  - Choose the correct answer by going through the tunnel with its color.
  - If you get it wrong, you will fall into the void.
  - Also, avoid walls or you will crash the wagon.
  dannyDialogUI: {fileID: 1114704640}
  dannyDialogText: {fileID: 1462200713}
  dannyYesButton: {fileID: 93248337}
  dannyNoButton: {fileID: 1762262196}
  dannyContinueButton: {fileID: 1741406456}
